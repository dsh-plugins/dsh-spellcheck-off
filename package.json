{
  "name": "dsh-spellcheck-off",
  "version": "0.1.0",
  "description": "禁用 DSH Web 界面所有文本输入框的浏览器拼写检查",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-spellcheck-off.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-spellcheck-off",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-spellcheck-off/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.client.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0-0"
  },
  "icon": "./icon.svg"
}
